{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "schema_version": {
      "type": "string",
      "const": "haze.independent_check.v2"
    },
    "checker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "independent_of_producer": {
      "type": "boolean",
      "const": true
    },
    "scope": {
      "type": "string",
      "const": "engineering_numeric_constraint_check"
    },
    "planner_input_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "snapshot_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "bundle_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "scenario_refs": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["id", "revision", "sha256"],
        "additionalProperties": false
      }
    },
    "calculation_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["id", "revision", "sha256"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "calculation_reason": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["code", "explanation"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["id", "revision", "sha256"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_reason": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["code", "explanation"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "findings": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "predicate": {
            "type": "string",
            "enum": [
              "reference_integrity",
              "fixed_work",
              "full_occupancy",
              "normalized_constraints",
              "coverage",
              "paired_scenarios",
              "integration",
              "worker_nonincrease",
              "matched_activity_nonincrease",
              "action_floor",
              "movement_caps",
              "ranking"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_assessable"]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": ["predicate", "status", "detail"],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "not_assessable"]
    },
    "human_review_status": {
      "type": "string",
      "const": "pending"
    },
    "approval_authority": {
      "type": "string",
      "const": "none"
    }
  },
  "required": [
    "id",
    "revision",
    "schema_version",
    "checker_id",
    "producer_id",
    "independent_of_producer",
    "scope",
    "planner_input_ref",
    "snapshot_ref",
    "bundle_ref",
    "policy_ref",
    "scenario_refs",
    "calculation_ref",
    "calculation_reason",
    "plan_ref",
    "plan_reason",
    "checked_at",
    "findings",
    "status",
    "human_review_status",
    "approval_authority"
  ],
  "additionalProperties": false,
  "$id": "urn:haze:schema:haze.independent_check.v2",
  "title": "haze.independent_check.v2",
  "description": "Haze architecture v0.13 structural contract. Also run the runtime semantic validator; a schema pass grants no operating authority.",
  "x-canonical-serializer": "haze.canonical-json.v1"
}
