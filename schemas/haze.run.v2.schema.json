{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "haze.run.v2"
    },
    "programme_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "input": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "plan_outdoor_work"
        },
        "problem_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "bundle_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["id", "revision", "sha256"],
          "additionalProperties": false
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": ["operation", "problem_id", "bundle_ref"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "programme_id", "input"],
  "additionalProperties": false,
  "$id": "urn:haze:schema:haze.run.v2",
  "title": "haze.run.v2",
  "description": "Haze architecture v0.13 structural contract. Also run the runtime semantic validator; a schema pass grants no operating authority.",
  "x-canonical-serializer": "haze.canonical-json.v1"
}
