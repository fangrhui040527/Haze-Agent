{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "schema_version": {
      "type": "string",
      "const": "haze.evidence.v2"
    },
    "source_kind": {
      "type": "string",
      "const": "synthetic_fixture"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_owner": {
      "type": "string",
      "const": "fictional_engineering_fixture"
    },
    "raw_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "passage"
            },
            "document_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "revision": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": ["id", "revision", "sha256"],
              "additionalProperties": false
            },
            "page": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "section": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "start_offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end_offset": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "offset_unit": {
              "type": "string",
              "const": "unicode_code_points"
            },
            "quote_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "document_ref",
            "page",
            "section",
            "quote",
            "start_offset",
            "end_offset",
            "offset_unit",
            "quote_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "data"
            },
            "series_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "row_indices": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "intervals": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              }
            },
            "location_ids": {
              "minItems": 1,
              "maxItems": 128,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              }
            },
            "selection_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "series_id",
            "run_id",
            "row_indices",
            "intervals",
            "location_ids",
            "selection_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "structured_fields"
            },
            "record_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "revision": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": ["id", "revision", "sha256"],
              "additionalProperties": false
            },
            "field_pointers": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(\\/(?:[^~/]|~[01])*)+$"
              }
            }
          },
          "required": ["kind", "record_ref", "field_pointers"],
          "additionalProperties": false
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "preparation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "method_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["id", "revision", "sha256"],
          "additionalProperties": false
        }
      },
      "required": ["preparation", "method_ref"],
      "additionalProperties": false
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "permitted_uses": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "engineering_historical"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "disposition": {
      "type": "string",
      "const": "fixture_not_accepted"
    },
    "accepted_at": {
      "type": "null"
    },
    "acceptance_reason": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": ["code", "explanation"],
      "additionalProperties": false
    },
    "review_refs": {
      "type": "array",
      "prefixItems": [],
      "items": false,
      "maxItems": 0
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  },
  "required": [
    "id",
    "revision",
    "schema_version",
    "source_kind",
    "title",
    "source_owner",
    "raw_ref",
    "raw_sha256",
    "locator",
    "provenance",
    "retrieved_at",
    "permitted_uses",
    "disposition",
    "accepted_at",
    "acceptance_reason",
    "review_refs",
    "limitations"
  ],
  "additionalProperties": false,
  "$id": "urn:haze:schema:haze.evidence.v2",
  "title": "haze.evidence.v2",
  "description": "Haze architecture v0.13 structural contract. Also run the runtime semantic validator; a schema pass grants no operating authority.",
  "x-canonical-serializer": "haze.canonical-json.v1"
}
