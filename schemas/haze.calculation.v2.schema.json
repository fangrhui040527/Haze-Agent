{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "schema_version": {
      "type": "string",
      "const": "haze.calculation.v2"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "planner_input_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "bundle_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "baseline_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "revision", "sha256"],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["id", "revision", "sha256"],
          "additionalProperties": false
        },
        "assignments": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "activity_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "start": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": ["activity_id", "start"],
            "additionalProperties": false
          }
        }
      },
      "required": ["plan_ref", "assignments"],
      "additionalProperties": false
    },
    "role": {
      "type": "string",
      "enum": ["baseline", "less_disruption", "lower_proxy"]
    },
    "worker_unit": {
      "type": "string",
      "const": "hours * ug/m3"
    },
    "crew_unit": {
      "type": "string",
      "const": "person-hours * ug/m3"
    },
    "scenario_values": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario_ref": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": ["id", "revision", "sha256"],
            "additionalProperties": false
          },
          "per_worker": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "worker_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "baseline": {
                  "type": "number",
                  "minimum": 0
                },
                "candidate": {
                  "type": "number",
                  "minimum": 0
                },
                "delta": {
                  "type": "number"
                },
                "activities": {
                  "minItems": 1,
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "activity_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                      },
                      "baseline": {
                        "type": "number",
                        "minimum": 0
                      },
                      "candidate": {
                        "type": "number",
                        "minimum": 0
                      },
                      "delta": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "activity_id",
                      "baseline",
                      "candidate",
                      "delta"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "worker_id",
                "baseline",
                "candidate",
                "delta",
                "activities"
              ],
              "additionalProperties": false
            }
          },
          "crew": {
            "type": "object",
            "properties": {
              "baseline": {
                "type": "number",
                "minimum": 0
              },
              "candidate": {
                "type": "number",
                "minimum": 0
              },
              "delta": {
                "type": "number"
              },
              "absolute_gain": {
                "type": "number"
              },
              "percentage_gain": {
                "type": ["number", "null"]
              },
              "percentage_reason": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                      },
                      "explanation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": ["code", "explanation"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "baseline",
              "candidate",
              "delta",
              "absolute_gain",
              "percentage_gain",
              "percentage_reason"
            ],
            "additionalProperties": false
          }
        },
        "required": ["scenario_ref", "per_worker", "crew"],
        "additionalProperties": false
      }
    },
    "disruption": {
      "type": "object",
      "properties": {
        "total_movement_minutes": {
          "type": "number",
          "minimum": 0
        },
        "changed_activity_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "per_activity": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "activity_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "absolute_movement_minutes": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["activity_id", "absolute_movement_minutes"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "total_movement_minutes",
        "changed_activity_count",
        "per_activity"
      ],
      "additionalProperties": false
    },
    "action_qualification": {
      "type": "object",
      "properties": {
        "worker_protection": {
          "type": "string",
          "enum": ["pass", "fail"]
        },
        "activity_protection": {
          "type": "string",
          "enum": ["pass", "fail"]
        },
        "threshold_status": {
          "type": "string",
          "enum": ["met", "below"]
        },
        "movement_status": {
          "type": "string",
          "enum": ["pass", "fail"]
        },
        "qualifying": {
          "type": "boolean"
        }
      },
      "required": [
        "worker_protection",
        "activity_protection",
        "threshold_status",
        "movement_status",
        "qualifying"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "revision",
    "schema_version",
    "producer_id",
    "planner_input_ref",
    "bundle_ref",
    "policy_ref",
    "baseline_ref",
    "plan",
    "role",
    "worker_unit",
    "crew_unit",
    "scenario_values",
    "disruption",
    "action_qualification"
  ],
  "additionalProperties": false,
  "$id": "urn:haze:schema:haze.calculation.v2",
  "title": "haze.calculation.v2",
  "description": "Haze architecture v0.13 structural contract. Also run the runtime semantic validator; a schema pass grants no operating authority.",
  "x-canonical-serializer": "haze.canonical-json.v1"
}
