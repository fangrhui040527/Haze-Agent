{
  "name": "haze-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local TypeScript workflow infrastructure for Haze Agent",
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.8.0"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "start": "node scripts/run-example.mjs",
    "tasks:serve": "node --env-file-if-exists=app/adapters/zetaris/.env.local --env-file-if-exists=.env scripts/serve-tasks.mjs",
    "tasks:verify": "npm run build && node --env-file-if-exists=app/adapters/zetaris/.env.local --env-file-if-exists=.env scripts/verify-general.mjs",
    "manager:evaluate": "node --env-file-if-exists=.env scripts/evaluate-manager.mjs",
    "manager:test": "node scripts/test-manager.mjs",
    "manager:test:unit": "vitest run --project unit tests/unit/manager-",
    "manager:test:live": "node --env-file-if-exists=.env scripts/test-manager.mjs --live",
    "manager:chat": "node --env-file-if-exists=.env scripts/chat-manager.mjs",
    "db:init": "docker compose up -d --wait smokeledger-db",
    "zetaris:fetch:firms": "node --experimental-strip-types app/adapters/zetaris/sources/nasa_firms/fetch_nasa_firms.ts",
    "zetaris:fetch:wind": "node --experimental-strip-types app/adapters/zetaris/sources/wind/fetch_wind.ts",
    "zetaris:fetch:pm25": "node --experimental-strip-types app/adapters/zetaris/sources/air_quality/fetch_air_quality.ts",
    "zetaris:bootstrap:sources": "node --experimental-strip-types app/adapters/zetaris/usl/bootstrap_sources.ts",
    "smokeledger:fetch:firms": "npm run zetaris:fetch:firms --",
    "smokeledger:fetch:wind": "npm run zetaris:fetch:wind --",
    "smokeledger:fetch:pm25": "npm run zetaris:fetch:pm25 --",
    "smokeledger:install": "npm --prefix smokeledger ci && npm --prefix smokeledger run setup",
    "smokeledger:serve": "node scripts/serve-smokeledger.mjs",
    "smokeledger:serve:sample": "node scripts/serve-smokeledger.mjs --sample",
    "smokeledger:test": "npm --prefix smokeledger test && npm --prefix smokeledger run conformance",
    "zetaris:bootstrap:smokeledger": "node --experimental-strip-types app/adapters/zetaris/usl/bootstrap_smokeledger.ts",
    "build": "npm run vendor:engines && node scripts/build.mjs",
    "vendor:engines": "node scripts/vendor-engines.mjs",
    "verify:pins": "node scripts/verify-pins.mjs",
    "test:engines": "node scripts/test-engines.mjs",
    "probe:compatibility": "npm run build && node --env-file-if-exists=.env scripts/probe-compatibility.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.zetaris.json && tsc -p tsconfig.smokeledger.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:postgres": "vitest run --project postgres",
    "test:integration": "node scripts/verify-general.mjs --fixture && node scripts/verify-damage-account.mjs --fixture && npm run test:crashes",
    "damage:verify": "npm run build && node --env-file-if-exists=.env scripts/verify-damage-account.mjs",
    "damage:demo": "npm run build && node scripts/demo-damage-account.mjs",
    "frontend:check": "npm --prefix frontend run build && npm --prefix frontend test",
    "check": "npm run verify:pins && npm run format:check && npm run typecheck && npm run lint && npm run build && npm test && npm run test:engines && npm run frontend:check && npm run test:integration",
    "tasks:test": "vitest run --project unit tests/unit/general-store.test.ts tests/unit/general-runtime.test.ts tests/unit/general-http.test.ts tests/unit/pm25-methods.test.ts",
    "test:crashes": "node scripts/verify-langgraph-crashes.mjs",
    "test:rollback": "node scripts/verify-langgraph-rollback.mjs",
    "state:migrate": "node scripts/migrate-general-state.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
