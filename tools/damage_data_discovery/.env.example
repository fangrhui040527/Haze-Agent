# Copy this file to .env and replace the placeholder locally.
# Never commit .env or put a real API key in this template.
NVIDIA_API_KEY=replace-with-your-rotated-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: Meterless local OpenAI-compatible runtime.
METERLESS_API_KEY=replace-with-your-meterless-api-key
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_MODEL=meterless/auto
