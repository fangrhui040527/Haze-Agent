{
  "name": "haze-server",
  "version": "0.1.0",
  "private": true,
  "description": "Compatibility launcher for the shared Haze application backend in app/",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env index.mjs",
    "dev": "node --watch --env-file-if-exists=../.env index.mjs",
    "typecheck": "npm --prefix .. run typecheck",
    "test": "npm --prefix .. test"
  },
  "dependencies": {},
  "devDependencies": {}
}
