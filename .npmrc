# engine-strict is deliberately NOT enabled. The supported toolchain is declared
# as a range in package.json "engines" and pinned exactly in .nvmrc /
# .node-version, so a mismatch prints an EBADENGINE warning instead of blocking
# install outright. This also matches frontend/, which has no .npmrc of its own.
# Re-enable it only alongside a committed version manager, or a clean clone is
# uninstallable on any machine whose Node patch differs.
# engine-strict=true
save-exact=true
package-lock=true
