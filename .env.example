# The probe CLI and frontend's local server read root .env; libraries take explicit env.
# npm start examples run offline and need no environment configuration.
# Their traces go to logs/ by default; override with --logs-dir PATH.
# Local execution checkpoints, separate from future canonical domain evidence.
STATE_DIR=.state/general-v1

# v3 general tasks: source synthesis and bounded episode/PM2.5 investigation.
# Existing databases are archival; incompatible configured directories fail safely.
# Configure Zetaris in app/adapters/zetaris/.env.local or process environment:
# ZETARIS_API_KEY, ZETARIS_REST_URL, ZETARIS_ORG_ID.
# Normal execution uses configured live adapters; --fixture is an explicit test mode.
# HAZE_TASK_PORT=8787

# Selected provider for the compatibility probe and evidence/orchestration agents.
HAZE_PROVIDER=nvidia
# Required for live model requests; create your own key with the selected provider.
NVIDIA_API_KEY=
# Optional provider-neutral key, which takes precedence over NVIDIA_API_KEY.
HAZE_PROVIDER_API_KEY=
# HAZE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# For HAZE_PROVIDER=openai-compatible, also set both:
# HAZE_PROVIDER_BASE_URL=https://your-provider.example/v1
# HAZE_MODEL=your-model-name
# Use HAZE_PROVIDER=offline for local-only proof; provider generation is skipped.
# SAMPLE_MODE=true enforces offline operation even if a provider is selected.
# Evidence task execution requires the selected provider and key; offline mode reports
# unavailable instead of simulating model execution. Keys must never use VITE_* names.

# Optional NASA FIRMS data ingestion. Keep the real key in local .env only.
# FIRMS_MAP_KEY=
# FIRMS_DAYS=1

# Optional override for the local SmokeLedger PostgreSQL database.
# SMOKELEDGER_DATABASE_URL=postgres://smokeledger:smokeledger@localhost:5433/smokeledger

# Optional integration tests ONLY: use a disposable local PostgreSQL database.
# HAZE_TEST_POSTGRES_URL=postgresql://haze:haze@localhost:5432/haze_test

# Haze server (server/README.md). Values are secrets: set them in .env only.
# OPEN_AQ_KEY=
# FIRMS_MAP_KEY=
# ZETARIS_USERNAME=
# ZETARIS_PASSWORD=
# ZETARIS_BASE_URL=http://localhost:3000
# HAZEOPS_COVERAGE=asean
