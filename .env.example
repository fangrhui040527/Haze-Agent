# Copy this file to .env at the Haze repository root and fill in your own values.
# .env is gitignored. Never commit real credentials or put them in VITE_* variables.
# This is the shared server-side template for Haze and its Zetaris helpers.
# Existing app/adapters/zetaris/.env.local remains a fallback for missing settings.
# npm start examples run offline and need no environment configuration.

# Haze task runtime
# Local execution checkpoints, separate from canonical domain evidence.
# Existing databases are archival; incompatible configured directories fail safely.
STATE_DIR=.state/general-v2
# Optional Vite override for the shared dashboard/task/World Model directory.
# HAZE_TASK_STATE_DIR=.state/general-v2
# HAZE_TASK_PORT=8787
# Normal execution uses live adapters; --fixture is an explicit test mode.
# Example traces go to logs/ by default; override with --logs-dir PATH.

# Model provider (compatibility probe and evidence/orchestration agents)
# Nightshift runs locally; the selected Nemotron model runs on NVIDIA's cloud.
# Configure the NVIDIA API key in Nightshift. Haze reuses its installed runtime token.
HAZE_PROVIDER=nightshift
HAZE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
HAZE_PROVIDER_BASE_URL=http://127.0.0.1:8088/v1
SAMPLE_MODE=false
# For direct NVIDIA access, set HAZE_PROVIDER=nvidia and unset the base URL above.
NVIDIA_API_KEY=
# For direct providers, this optional key takes precedence over NVIDIA_API_KEY.
HAZE_PROVIDER_API_KEY=
# For HAZE_PROVIDER=openai-compatible, replace the base URL and HAZE_MODEL above:
# HAZE_PROVIDER_BASE_URL=https://your-provider.example/v1
# Use HAZE_PROVIDER=offline to skip provider generation.
# SAMPLE_MODE=true enforces offline operation even with a provider selected.
# Evidence tasks require a provider and key; offline mode reports unavailable.

# Manager chat execution budgets (server only; per message, not chat length).
# These settings also appear in `haze> config show`. Restart the app after edits.
# Model calls include retrieval decisions, correction attempts and the final reply.
# Allow enough model calls for the retrieval/correction budgets you choose.
HAZE_MANAGER_MAX_MODEL_CALLS=6
HAZE_MANAGER_MAX_RETRIEVALS=4
HAZE_MANAGER_TIMEOUT_MS=120000
HAZE_MANAGER_MAX_OUTPUT_TOKENS=2400
HAZE_MANAGER_MAX_CORRECTIONS=1

# Role-specific inference (optional, server only). Unmapped roles inherit the
# shared provider above. Versioned profiles and mappings are validated at startup.
# Example mixed route; replace endpoint/model/key reference with your own:
# HAZE_MODEL_ROUTES_JSON={"version":1,"profiles":{"specialist":{"provider":"openai-compatible","model":"your-model","base_url":"https://your-provider.example/v1","credential_env":"SPECIALIST_API_KEY","policy":"provider-default"}}}
# HAZE_AGENT_ROUTES_JSON={"version":1,"routes":{"HazeOps":"specialist","WorkerShield":"specialist","EvidenceCritic":"specialist","DamageAccountant":"specialist"}}
# SPECIALIST_API_KEY=
# The five roles are Manager, HazeOps, WorkerShield, EvidenceCritic, DamageAccountant.
# New admissions pin routes; configuration edits do not remap existing runs.
# Nightshift profiles use provider=nightshift and a concrete model, defaulting to
# its loopback API. Credentials use credential_env or the installed runtime token.
# Install the inspected strict transport with npm run nightshift:contract:install.
# Supported NVIDIA/Nemotron routes negotiate a contract before each charged call;
# unsupported builds/models/policies remain blocked. Reachability is insufficient.
# policy=local-only fails closed until compute locality can be enforced; a local
# API address alone is insufficient. Direct calls have Haze call/token limits,
# independent of any future background-job spending cap.

# Nightshift candidate jobs (separate from direct role inference).
# CLI discovery uses the installed executable/ns.mjs without a shell. Optional:
# HAZE_NIGHTSHIFT_CLI=C:/Users/YOU/AppData/Local/Nightshift/cli/ns.mjs
# Keep runtime credentials server-side; the installed CLI's authentication is reused.
# Application-wide admission bounds (submitting/unknown/unconfirmed jobs count).
# HAZE_NIGHTSHIFT_MAX_JOBS=2
# HAZE_NIGHTSHIFT_MAX_CHAINS=8
# Automatic chains have no environment enable switch. Production admission stays
# blocked until trusted server release evidence validates the prerequisite live
# gates. GET /api/nightshift/automation/readiness explains the current gate.
# New chains default to cloud-ok with no monetary cap. Job/attempt/lifetime limits
# still apply. The installed runtime cannot enforce a positive dollar ceiling.
# Explicit local-only chains retain $0 cloud spend, including existing grants.
# Configure eligible models/active fleets in Nightshift's cockpit. Haze does not
# install models, change fleets or start an operating-system service.

# Local Zetaris deployment (run docker compose from the Haze repository root).
# Copy the matching image references from the .env issued with your Zetaris download.
# When moving an existing install, retain its database password and administrator settings.
DRIVER_IMAGE=
API_IMAGE=
UI_IMAGE=
POSTGRES_USER=zetaris
POSTGRES_PASSWORD=
ZETARIS_ADMIN_EMAIL=admin@zetaris.com
ZETARIS_ADMIN_PASSWORD=
ZETARIS_ADMIN_ORG=zetaris
ZSPARK_DRIVER_MEM=2g
ZSPARK_DRIVER_CORES=2
ZSPARK_MASTER_URL=local[2]
ZETARIS_API_MAX_HEAP=1g
UI_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
GUI_URL=http://localhost:3000
API_PORT=8888
API_INTERNAL_PORT=8889
DRIVER_PORT=10000
SPARK_UI_PORT=4040
# Optional HTTPS deployment: enable the tls profile and set your public hostname.
# COMPOSE_PROFILES=tls
# ZETARIS_PUBLIC_HOST=zetaris.example.com

# Integration tests ONLY: use a disposable local PostgreSQL database.
# HAZE_TEST_POSTGRES_URL=postgresql://haze:haze@localhost:5432/haze_test

# Zetaris authentication (create your own API key in the Zetaris GUI)
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Zetaris UI proxy (TypeScript/Python API helpers and dashboard server)
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=1000

# Zetaris REST/JDBC (run_sql.py, preflight.py and live evidence retrieval)
# Keep the REST URL distinct from the UI proxy above.
# Current PM2.5 tasks read published air_quality.hourly_observations snapshots.
# Publish with zetaris:fetch:pm25 or zetaris:bootstrap:sources.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# Full path to your Zetaris JDBC driver JAR (required only for JDBC).
ZETARIS_JDBC_JAR=
# Replaces YOUR_APP_NAME YOUR_CONTACT_EMAIL in create scripts.
# Set your own app name and real contact email; SEC EDGAR requires a real contact.
# ZETARIS_USER_AGENT="your-app your-contact@example.com"


FIRMS_MAP_KEY=ea17d5820daffb2467bc6afd1ed2e15a
WINDY_API_KEY=6QWR4xIsu6YJHedVzTDFuTgYsQtkthdr

# Shared dashboard and HazeOps configuration (app/dashboard/README.md)
OPEN_AQ_KEY=6b788875376d28408aa56c8fb26fccd66080d99767f078d3037c4b5143e14d8d
# HAZEOPS_COVERAGE=asean
# HAZEOPS_SCHEDULER=off
# HAZE_OPERATOR_TOKEN=
# HAZE_STATE_DIR is retired; use the explicit dashboard state migration command
# for an existing .state/haze archive. All active data uses STATE_DIR above.
