# Documentation only: set these in your shell; the library does not load .env.
# npm start examples run offline and need no environment configuration.
# Their traces go to logs/ by default; override with --logs-dir PATH.
# Local execution checkpoints, separate from future canonical domain evidence.
STATE_DIR=.state

# Selected-provider compatibility probe (CLI reads local .env; library does not).
HAZE_PROVIDER=nvidia
# NVIDIA_API_KEY=replace-with-your-local-key
# HAZE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Use HAZE_PROVIDER=offline for local-only proof; provider generation is skipped.
# SAMPLE_MODE=true enforces offline operation even if a provider is selected.

# Optional integration tests ONLY: use a disposable local PostgreSQL database.
# HAZE_TEST_POSTGRES_URL=postgresql://haze:haze@localhost:5432/haze_test
