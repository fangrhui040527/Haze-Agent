# Copy to .env and fill in. Never commit .env.

# --- Harness ---
# true = offline: embedded DB with the fictional sample, no Zetaris, no hosted model
SAMPLE_MODE=false
STATE_DIR=.state
LOG_DIR=logs
PORT=8000
# postgres (live, registered in Zetaris) | pglite (embedded)
DB_MODE=postgres

# --- Evidence store (docker compose up -d) ---
PG_URL=postgres://smokeledger:smokeledger@localhost:5433/smokeledger

# --- Data: Zetaris (local Docker install) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=paste-key-created-in-zetaris-web-ui
# Name you give the datasource in sql/02_zetaris_register.sql
ZETARIS_SOURCE=sl_pg
# zetaris = every evidence query goes through Zetaris (use this for the demo)
# postgres = run the same SQL straight on Postgres (only for development before Zetaris is wired)
QUERY_BACKEND=zetaris

# --- Power: Meterless Nightshift (values from Nightshift > Console) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=paste-nightshift-runtime-token
METERLESS_APP=smokeledger
# Pin Nemotron routes from GET /v1/models once you know them. meterless/auto works to start.
MODEL_DEEP=meterless/auto
MODEL_JUDGE=meterless/auto

# --- Actions ---
# true = every outgoing notice goes to SANDBOX_RECIPIENT only (keep true for the hackathon)
DEMO_MODE=true
SANDBOX_RECIPIENT=you@example.com

# Spacing (degrees) of the wind grid you fetched from Open-Meteo
WIND_GRID_STEP=1.0
