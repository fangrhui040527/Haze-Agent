# Copy to .env.local (never commit .env.local).
# Everything starting with VITE_ is bundled into the browser code and visible to every visitor:
# NEVER put secrets, tokens or Zetaris credentials here.

# Leave empty to use the same-origin task API provided by npm run dev / preview.
# An external deployment must supply its own authenticated backend adapter.
VITE_API_BASE_URL=

# General v3 task execution is configured server-side with HAZE_EXECUTION_MODE.
# No protocol or orchestration feature flags are used in the browser.

# NASA FIRMS MAP_KEY for the landing-page fire-hotspot layer (free: https://firms.modaps.eosdis.nasa.gov/api/map_key/).
# Optional. Without it the layer is hidden and labelled "Fire layer needs a FIRMS key".
# Note: VITE_ values ship to the browser; a FIRMS MAP_KEY is rate-limited, not a secret credential,
# but keep it in .env.local and never commit it.
VITE_FIRMS_MAP_KEY=
